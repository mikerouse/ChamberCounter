{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "vite: dev",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": [{
					"regexp": "^$",
					"file": 1,
					"location": 2,
					"message": 3
				}],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": ".*ready in.*"
				}
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "vite: build",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "vite: preview",
			"type": "shell",
			"command": "npm",
			"args": ["run", "preview"],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "vitest: run all",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test:run"],
			"problemMatcher": [],
			"group": { "kind": "test", "isDefault": true }
		},
		{
			"label": "vitest: watch",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test"],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
